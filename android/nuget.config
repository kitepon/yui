<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="login-billing" value=".nuget-local" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Our ids come from the local folder only, never from nuget.org (scripts/fetch-library.sh fills it). -->
  <packageSourceMapping>
    <packageSource key="login-billing">
      <package pattern="Kitepon.LoginBilling.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
