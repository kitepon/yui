{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Throughline Monitor",
      "detail": "Auto-generated by Throughline. Opens token-monitor in a dedicated terminal when the folder is opened.",
      "type": "shell",
      "command": "/opt/homebrew/Cellar/node/26.7.0/bin/node",
      "args": [
        "/opt/homebrew/lib/node_modules/throughline/bin/throughline.mjs",
        "monitor"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "throughline",
        "close": false,
        "echo": false,
        "focus": false,
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
